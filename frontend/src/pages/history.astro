---
import BaseLayout from "../layouts/BaseLayout.astro";
import Disclaimer from "../components/Disclaimer.astro";
---
<BaseLayout title="History — AI Pre-Mortem Engine">
<h1 class="mb-4 font-serif text-2xl font-bold text-boardroom">History</h1>
<Disclaimer />
<div class="rounded border border-boardroom/20 bg-white p-4">
  <ul id="list" class="space-y-2 text-sm"><li class="text-charcoal/70">Loading…</li></ul>
  <p id="err" class="mt-2 text-sm text-riskred"></p>
</div>
<script>
  import { apiGet, apiDelete } from '../lib/apiClient';
  function rowsOf(d: unknown): any[] {
    if (Array.isArray(d)) return d as any[];
    if (d && typeof d === 'object') {
      const o = d as Record<string, unknown>;
      if (Array.isArray(o.rows)) return o.rows as any[];
      if (Array.isArray(o.sessions)) return o.sessions as any[];
      if (Array.isArray(o.history)) return o.history as any[];
    }
    return [];
  }
  async function load() {
    const list = document.getElementById('list')!;
    const err = document.getElementById('err')!;
    try {
      const data = await apiGet('/api/premortem/history');
      const items = rowsOf(data);
      list.innerHTML = '';
      if (!items.length) list.innerHTML = '<li class="text-charcoal/70">No pre-mortems yet.</li>';
      for (const s of items) {
        const li = document.createElement('li');
        li.className = 'flex flex-wrap items-center justify-between gap-2 rounded border border-boardroom/20 bg-slate-50 px-3 py-2';
        const span = document.createElement('span');
        const n = s.scenarios ?? s.count ?? '';
        span.textContent = `#${s.id ?? s.session_id} ${s.name ?? s.project_name ?? ''} · ${s.project_type ?? ''} · ${n === '' ? '' : n + ' scenarios'}`;
        const wrap = document.createElement('span');
        wrap.className = 'flex gap-2';
        const sid = s.id ?? s.session_id;
        const a = document.createElement('a');
        a.href = `/scenarios?sid=${sid}`;
        a.textContent = 'Open';
        a.className = 'rounded bg-boardroom px-2 py-0.5 text-white';
        const del = document.createElement('button');
        del.textContent = 'Delete';
        del.className = 'rounded border border-riskred/60 px-2 py-0.5 text-riskred';
        del.onclick = async () => {
          try {
            await apiDelete(`/api/premortem/${sid}`);
            await load();
          } catch (e) {
            err.textContent = e instanceof Error ? e.message : 'Delete failed.';
          }
        };
        wrap.append(a, del);
        li.append(span, wrap);
        list.appendChild(li);
      }
    } catch (e) {
      err.textContent = e instanceof Error ? e.message : 'Load failed. Sign in via Settings first.';
    }
  }
  load();
</script>
</BaseLayout>
