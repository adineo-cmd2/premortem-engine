---
import BaseLayout from "../layouts/BaseLayout.astro";
import Disclaimer from "../components/Disclaimer.astro";
---
<BaseLayout title="Submit — AI Pre-Mortem Engine">
<h1 class="mb-4 font-serif text-2xl font-bold text-boardroom">Describe your project</h1>
<Disclaimer />
<div class="rounded border border-boardroom/20 bg-white p-4">
  <label class="block text-xs font-bold text-boardroom" for="project_name">Project name</label>
  <input id="project_name" type="text" placeholder="e.g. Field sensor rollout" class="mt-1 w-full rounded border border-boardroom/30 bg-slate-50 p-2 text-sm" />
  <label class="mt-3 block text-xs font-bold text-boardroom" for="description">Description</label>
  <textarea id="description" rows="5" placeholder="What are you building, for whom, and what does launch look like? Keywords shape the scenarios…" class="mt-1 w-full rounded border border-boardroom/30 bg-slate-50 p-2 text-sm"></textarea>
  <div class="mt-3 grid grid-cols-1 gap-2 md:grid-cols-3">
    <div>
      <label class="block text-xs font-bold text-boardroom" for="project_type">Project type</label>
      <select id="project_type" class="mt-1 w-full rounded border border-boardroom/30 bg-slate-50 p-2 text-sm">
        <option value="software">software</option>
        <option value="hardware">hardware</option>
        <option value="research">research</option>
        <option value="event">event</option>
        <option value="business">business</option>
        <option value="default">default</option>
      </select>
    </div>
    <div>
      <label class="block text-xs font-bold text-boardroom" for="launch_date">Launch date</label>
      <input id="launch_date" type="date" class="mt-1 w-full rounded border border-boardroom/30 bg-slate-50 p-2 text-sm" />
    </div>
    <div>
      <label class="block text-xs font-bold text-boardroom" for="team_size">Team size</label>
      <input id="team_size" type="number" min="1" value="5" class="mt-1 w-full rounded border border-boardroom/30 bg-slate-50 p-2 text-sm" />
    </div>
  </div>
  <label class="mt-3 block text-xs font-bold text-boardroom" for="dep_input">Key dependencies (Enter to add tag)</label>
  <div class="mt-1 flex gap-2">
    <input id="dep_input" type="text" placeholder="e.g. payment provider" class="w-full rounded border border-boardroom/30 bg-slate-50 p-2 text-sm" />
    <button id="dep_add" type="button" class="rounded border border-boardroom/40 px-3 py-1 text-sm">Add</button>
  </div>
  <div id="dep_tags" class="mt-2 flex flex-wrap gap-2 text-xs"></div>
  <label class="mt-3 block text-xs font-bold text-boardroom" for="known_risks">Known risks (optional)</label>
  <textarea id="known_risks" rows="2" placeholder="Anything already worrying you…" class="mt-1 w-full rounded border border-boardroom/30 bg-slate-50 p-2 text-sm"></textarea>
  <div class="mt-3 flex items-center gap-3">
    <button id="go" class="rounded bg-boardroom px-4 py-2 text-sm font-bold text-white">Run pre-mortem</button>
    <p id="err" class="text-sm text-riskred"></p>
  </div>
</div>
<p class="mt-3 text-xs text-charcoal/70">Outputs are a speculative planning aid, not predictions.</p>
<script>
  import { apiPost } from '../lib/apiClient';
  const deps: string[] = [];
  const depInput = document.getElementById('dep_input') as HTMLInputElement;
  const depTags = document.getElementById('dep_tags')!;
  function renderDeps() {
    depTags.innerHTML = '';
    deps.forEach((d, i) => {
      const span = document.createElement('span');
      span.className = 'rounded bg-boardroom px-2 py-0.5 text-white';
      span.textContent = d + ' ×';
      span.style.cursor = 'pointer';
      span.onclick = () => { deps.splice(i, 1); renderDeps(); };
      depTags.appendChild(span);
    });
  }
  function addDep() {
    const v = depInput.value.trim();
    if (v) { deps.push(v); depInput.value = ''; renderDeps(); }
  }
  document.getElementById('dep_add')!.addEventListener('click', addDep);
  depInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') { e.preventDefault(); addDep(); }
  });
  const btn = document.getElementById('go')!;
  const err = document.getElementById('err')!;
  btn.addEventListener('click', async () => {
    err.textContent = '';
    const project_name = (document.getElementById('project_name') as HTMLInputElement).value;
    const description = (document.getElementById('description') as HTMLTextAreaElement).value;
    const project_type = (document.getElementById('project_type') as HTMLSelectElement).value;
    const launch_date = (document.getElementById('launch_date') as HTMLInputElement).value;
    const team_size = Number((document.getElementById('team_size') as HTMLInputElement).value) || 1;
    const known_risks = (document.getElementById('known_risks') as HTMLTextAreaElement).value;
    btn.textContent = 'Running…';
    (btn as HTMLButtonElement).disabled = true;
    try {
      const res = await apiPost('/api/premortem/submit', {
        project_name,
        description,
        project_type,
        launch_date: launch_date || undefined,
        team_size,
        key_dependencies: deps,
        known_risks: known_risks || undefined,
      });
      const sid = res.session_id ?? res.id;
      window.location.href = `/scenarios?sid=${sid}`;
    } catch (e) {
      err.textContent = e instanceof Error ? e.message : 'Submit failed.';
      btn.textContent = 'Run pre-mortem';
      (btn as HTMLButtonElement).disabled = false;
    }
  });
</script>
</BaseLayout>
