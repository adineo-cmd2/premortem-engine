---
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const year = new Date().getFullYear();
const links: { href: string; label: string }[] = [{"href": "/", "label": "Home"}, {"href": "/submit", "label": "Submit"}, {"href": "/scenarios", "label": "Scenarios"}, {"href": "/mitigations", "label": "Mitigations"}, {"href": "/report", "label": "Report"}, {"href": "/history", "label": "History"}, {"href": "/settings", "label": "Settings"}];
---
<footer class="footer">
  <div class="footer-grid">
    <div>
      <a href={base || '/'} class="brand" style="margin-bottom: 0.9rem">
        <span class="brand-mark"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/><path d="M12 9v4M12 17h.01"/></svg></span>
        <span>AI Pre-Mortem Engine</span>
      </a>
      <p class="text-sm leading-relaxed" style="color: var(--ink-soft); max-width: 34rem">
        Speculative planning aid — not a prediction. Template-generated failure scenarios for structured planning discussion only.
      </p>
    </div>
    <div>
      <h4>Explore</h4>
      <ul class="footer-links">
        {links.map((l) => (
          <li>
            <a href={l.href === '/' ? base || '/' : `${base}${l.href}`}>{l.label}</a>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h4>Project</h4>
      <ul class="footer-links">
        <li><a href="https://github.com/adineo-cmd2/premortem-engine" target="_blank" rel="noreferrer">Source on GitHub ↗</a></li>
        <li><a href="https://adineo-cmd2.github.io/premortem-engine/" target="_blank" rel="noreferrer">Live site ↗</a></li>
        <li><span style="font-size: 0.88rem">Local backend · <span class="mono">localhost:8010</span></span></li>
        <li><span style="font-size: 0.88rem">FastAPI + Astro + React</span></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="footer-bottom-inner">
      <span>© {year} AI Pre-Mortem Engine · Aditya Yadav</span>
      <span>Deployed on GitHub Pages</span>
    </div>
  </div>
</footer>
